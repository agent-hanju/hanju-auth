# Auto detect text files and perform LF normalization
* text=auto

# Source code
*.java text eol=lf
*.kt text eol=lf
*.groovy text eol=lf
*.gradle text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.toml text eol=lf

# Shell scripts
*.sh text eol=lf
*.bash text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Documentation
*.md text eol=lf
*.txt text eol=lf
*.adoc text eol=lf

# Docker
Dockerfile text eol=lf
*.dockerfile text eol=lf
docker-compose*.yml text eol=lf
.dockerignore text eol=lf

# Git
.gitignore text eol=lf
.gitattributes text eol=lf
.gitmodules text eol=lf

# CI/CD
.gitlab-ci.yml text eol=lf
.travis.yml text eol=lf
Jenkinsfile text eol=lf

# Binary files
*.jar binary
*.war binary
*.ear binary
*.class binary
*.dll binary
*.exe binary
*.so binary
*.dylib binary

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text

# Fonts
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary

# Archives
*.zip binary
*.tar binary
*.gz binary
*.rar binary
*.7z binary

# Database
*.db binary
*.sqlite binary
*.sqlite3 binary

# Security files
*.pem binary
*.key binary
*.p12 binary
*.jks binary

# Linguist overrides for accurate language statistics
*.gradle linguist-language=Gradle
build.gradle linguist-language=Gradle
settings.gradle linguist-language=Gradle
gradlew linguist-generated=true
gradlew.bat linguist-generated=true
gradle/wrapper/* linguist-vendored=true

# Exclude generated files from diff
*.log -diff
*.class -diff
*.jar -diff
*.war -diff

# Mark documentation files
*.md linguist-documentation
docs/** linguist-documentation

# Export ignore (files not included in git archive)
.gitignore export-ignore
.gitattributes export-ignore
.github/ export-ignore
.gradle/ export-ignore
.idea/ export-ignore
*.iml export-ignore
